{
  "name": "jupyterlab-execute-time",
  "version": "3.3.0",
  "description": "Display cell timings in Jupyter Lab",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "execute time"
  ],
  "homepage": "https://github.com/deshaw/jupyterlab-execute-time",
  "bugs": {
    "url": "https://github.com/deshaw/jupyterlab-execute-time/issues"
  },
  "license": "BSD-3-Clause",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "schema/*.json",
    "style/index.js"
  ],
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "jupyterlab": {
    "extension": true,
    "schemaDir": "schema",
    "outputDir": "jupyterlab_execute_time/labextension",
    "sharedPackages": {
      "@date-fns/tz": false
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/deshaw/jupyterlab-execute-time.git"
  },
  "scripts": {
    "build": "jlpm run build:lib && jlpm run build:labextension:dev",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:lib": "tsc",
    "build:prod": "jlpm run clean && jlpm run build:lib && jlpm run build:labextension",
    "clean": "jlpm run clean:lib",
    "clean:all": "jlpm run clean:lib && jlpm run clean:labextension && jlpm run clean:lintcache",
    "clean:labextension": "rimraf jupyterlab_execute_time/labextension",
    "clean:lintcache": "rimraf .eslintcache",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "eslint": "jlpm run eslint:check --fix",
    "eslint:check": "eslint . --cache",
    "install:extension": "jlpm run build",
    "lint": "jlpm run prettier && jlpm run eslint",
    "lint:check": "jlpm run prettier:check && jlpm run eslint:check",
    "prepare": "jlpm run clean && jlpm run build:prod && husky install",
    "prettier": "jlpm run prettier:base --write --list-different",
    "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md}\"",
    "prettier:check": "jlpm run prettier:base --check",
    "test": "ts-mocha -p tests/tsconfig.json tests/**/*_spec.ts",
    "watch": "run-p watch:src watch:labextension",
    "watch:labextension": "jupyter-builder watch .",
    "watch:src": "tsc -w --sourceMap"
  },
  "resolutions": {
    "lib0": "0.2.111"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@jupyterlab/application": "^4.5.0",
    "@jupyterlab/apputils": "^4.5.0",
    "@jupyterlab/cells": "^4.5.0",
    "@jupyterlab/docregistry": "^4.5.0",
    "@jupyterlab/notebook": "^4.5.0",
    "@jupyterlab/observables": "^5.5.0",
    "@jupyterlab/settingregistry": "^4.5.0",
    "@lumino/coreutils": "^2.0.0-rc.1",
    "@lumino/widgets": "^2.0.0-rc.1",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@jupyter/builder": "^1.2.0",
    "@jupyter/eslint-plugin": "^1.1.0",
    "@types/chai": "^4.3.4",
    "@types/json-schema": "^7.0.11",
    "@types/mocha": "^10.0.1",
    "@types/react": "^18.0.26",
    "chai": "^4.3.7",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^17.0.0",
    "husky": "^8.0.3",
    "mocha": "^10.2.0",
    "npm-run-all2": "^8.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-mocha": "^10.0.0",
    "typescript": "~5.4.0",
    "typescript-eslint": "^8.0.0",
    "yjs": "^13.5.0"
  },
  "styleModule": "style/index.js"
}
